# Created automatically by the installer. Edit only if you know what you are doing.

# Version of the site images (updated by the "Update site" button)
HQSTUDIO_VERSION=latest

# Address of the site on this PC
HQ_PORT=8080

# Generated secrets
POSTGRES_PASSWORD=change-me
JWT_KEY=change-me-to-a-random-string-of-at-least-32-characters

# Password of the "admin" account (first start only)
ADMIN_PASSWORD=
# Full name shown for the admin account
ADMIN_NAME=

# Optional: public access through Tuna (https://tuna.am) on your own domain, e.g. crm.example.ru (paid Tuna plan)
TUNA_TOKEN=
TUNA_DOMAIN=
# Public address with scheme, e.g. https://crm.example.ru (needed for CORS)
PUBLIC_URL=

# Optional mirrors for restricted networks
POSTGRES_IMAGE=postgres:16-alpine
NGINX_IMAGE=nginx:1.27-alpine
TUNA_IMAGE=yuccastream/tuna:latest
