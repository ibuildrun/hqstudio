<UserControl x:Class="HQStudio.Setup.UI.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HQStudio.Setup.UI"
             xmlns:pages="clr-namespace:HQStudio.Setup.UI.Pages"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type pages:WelcomePageViewModel}">
            <pages:WelcomePageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DockerPageViewModel}">
            <pages:DockerPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:AccountPageViewModel}">
            <pages:AccountPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:KeysPageViewModel}">
            <pages:KeysPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SummaryPageViewModel}">
            <pages:SummaryPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:InstallPageViewModel}">
            <pages:InstallPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DonePageViewModel}">
            <pages:DonePageView/>
        </DataTemplate>

        <!-- Rail item: circle, label and the line to the next step -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type ui:StepItem}">
            <Grid Height="50" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle x:Name="Connector" Width="2" Height="16" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,32,0,0" Fill="#2A2A2A" RadiusX="1" RadiusY="1"
                           Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}"/>

                <Grid Width="28" Height="28" VerticalAlignment="Top">
                    <Ellipse x:Name="Circle" Fill="Transparent" Stroke="#3A3A3A" StrokeThickness="1.5"/>
                    <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#707070" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path x:Name="Mark" Style="{StaticResource IconPath}" Width="12" Height="12" StrokeThickness="2.2"
                          Stroke="#4CAF50" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="#707070"
                           Margin="14,0,0,0" VerticalAlignment="Top" Padding="0,4,0,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Circle" Property="Fill" Value="#FFFFFF"/>
                    <Setter TargetName="Circle" Property="Stroke" Value="#FFFFFF"/>
                    <Setter TargetName="Circle" Property="Effect" Value="{StaticResource GlowWhite}"/>
                    <Setter TargetName="Number" Property="Foreground" Value="#0A0A0A"/>
                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF"/>
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Circle" Property="Fill" Value="#1A2A1A"/>
                    <Setter TargetName="Circle" Property="Stroke" Value="#4CAF50"/>
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource IconCheck}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="#B0B0B0"/>
                    <Setter TargetName="Connector" Property="Fill" Value="#2F5A33"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                    <Setter TargetName="Circle" Property="Stroke" Value="#2A2A2A"/>
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource IconMinus}"/>
                    <Setter TargetName="Mark" Property="Stroke" Value="#505050"/>
                    <Setter TargetName="Label" Property="Foreground" Value="#505050"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Circle" Property="Fill" Value="#3A1A1A"/>
                    <Setter TargetName="Circle" Property="Stroke" Value="#F44336"/>
                    <Setter TargetName="Circle" Property="Effect" Value="{x:Null}"/>
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource IconCross}"/>
                    <Setter TargetName="Mark" Property="Stroke" Value="#F44336"/>
                    <Setter TargetName="Label" Property="Foreground" Value="#F44336"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Margin="12" Background="{StaticResource BgPrimaryBrush}" CornerRadius="18"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                Effect="{StaticResource WindowShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left rail with the steps -->
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" CornerRadius="17,0,0,17"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,1,0"
                        MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                    <Grid Margin="30,34,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="2" Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left"
                                Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ПРОВЕРОЧНЫЙ РЕЖИМ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentYellowBrush}"/>
                        </Border>

                        <StackPanel Grid.Row="0" Margin="0,0,0,34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HQ" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Black"/>
                                <TextBlock Text=" STUDIO" FontSize="28" FontWeight="Light" Foreground="#707070"/>
                            </StackPanel>
                            <TextBlock Text="УСТАНОВКА" Style="{StaticResource TextLabel}" Margin="2,2,0,0"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"
                                      IsTabStop="False" Focusable="False"/>
                    </Grid>
                </Border>

                <!-- Right side -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page header -->
                    <StackPanel Grid.Row="0" Margin="40,32,80,0" Background="Transparent"
                                Visibility="{Binding CurrentPage.ShowHeader, Converter={StaticResource BoolToVisibility}}"
                                MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                        <TextBlock x:Name="TitleText" Text="{Binding CurrentPage.Title}" Style="{StaticResource TextTitle}"/>
                        <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource TextBody}" Margin="0,6,0,0"
                                   Visibility="{Binding CurrentPage.Subtitle, Converter={StaticResource TextToVisibility}}"/>
                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,14,14,0" Panel.ZIndex="5">
                        <Button Style="{StaticResource BtnIcon}" Click="Minimize_Click" ToolTip="Свернуть">
                            <Path Data="{StaticResource IconMinus}" Style="{StaticResource IconPath}" Width="12" Height="12"
                                  Stroke="#707070"/>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Click="Close_Click" ToolTip="Закрыть" Margin="2,0,0,0">
                            <Path Data="{StaticResource IconCross}" Style="{StaticResource IconPath}" Width="12" Height="12"
                                  Stroke="#707070"/>
                        </Button>
                    </StackPanel>

                    <!-- Page -->
                    <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" IsTabStop="False"
                                    Margin="40,20,40,0" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageShift" Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,1,0,0"
                            Height="74" Margin="0,16,0,0">
                        <Grid Margin="40,0">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource TextSmall}" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" TextWrapping="NoWrap"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding CurrentPage.Tertiary.Text}" Command="{Binding CurrentPage.Tertiary.Command}"
                                        Style="{StaticResource BtnGhost}" Margin="0,0,10,0"
                                        Visibility="{Binding CurrentPage.Tertiary.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="{Binding CurrentPage.Secondary.Text}" Command="{Binding CurrentPage.Secondary.Command}"
                                        Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"
                                        Visibility="{Binding CurrentPage.Secondary.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                                <Button x:Name="PrimaryButton" Content="{Binding CurrentPage.Primary.Text}" Command="{Binding CurrentPage.Primary.Command}"
                                        Style="{StaticResource BtnPrimary}" IsDefault="True" MinWidth="130"
                                        Visibility="{Binding CurrentPage.Primary.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Confirmation overlay -->
                <Border Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" CornerRadius="17"
                        Visibility="{Binding HasDialog, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="430" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,26,28,22"
                            Background="{StaticResource BgCardBrush}" CornerRadius="16"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            DataContext="{Binding Dialog}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextH3}"/>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource TextBody}" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button x:Name="DialogCancel" Content="{Binding CancelText}" Style="{StaticResource BtnPrimary}"
                                        Click="DialogCancel_Click" Margin="0,0,10,0"/>
                                <Button x:Name="DialogConfirm" Content="{Binding ConfirmText}" Style="{StaticResource BtnDanger}"
                                        Click="DialogConfirm_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
