<UserControl x:Class="HQStudio.Setup.UI.Pages.DockerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HQStudio.Setup.UI">
    <UserControl.Resources>
        <Style x:Key="StatusIconCircle" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="23"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                    <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,4">

            <!-- Status -->
            <Border Style="{StaticResource Card}" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource StatusIconCircle}">
                        <Grid>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Stroke="#4CAF50" Width="22" Height="22"
                                  StrokeThickness="2.4" Visibility="{Binding StatusIsOk, Converter={StaticResource BoolToVisibility}}"/>
                            <Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPath}" Stroke="#FFC107" Width="22" Height="22"
                                  Visibility="{Binding StatusIsWarn, Converter={StaticResource BoolToVisibility}}"/>
                            <Path Data="{StaticResource IconCube}" Style="{StaticResource IconPath}" Stroke="#F44336" Width="22" Height="22"
                                  Visibility="{Binding StatusIsError, Converter={StaticResource BoolToVisibility}}"/>
                            <Control Style="{StaticResource Spinner}" Width="24" Height="24"
                                     Visibility="{Binding StatusIsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,1,0,0">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextBody}" Margin="0,4,0,0"/>

                        <!-- Docker installed but not running -->
                        <Button Content="Запустить Docker" Command="{Binding StartDockerCommand}" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Left" Margin="0,16,0,0"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Docker starting / installing -->
                        <ProgressBar IsIndeterminate="True" Style="{StaticResource SetupProgress}" Margin="0,16,0,0"
                                     Visibility="{Binding IsInstallingOrStarting, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Download -->
                        <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <ProgressBar Style="{StaticResource SetupProgress}" Value="0" Maximum="100"
                                         ui:Ui.SmoothValue="{Binding DownloadPercent}"/>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="{Binding DownloadText}" Style="{StaticResource TextSmall}" VerticalAlignment="Center"
                                           Foreground="#B0B0B0"/>
                                <Button Content="Отменить" Command="{Binding CancelDownloadCommand}" Style="{StaticResource BtnGhost}"
                                        HorizontalAlignment="Right" Padding="12,5"/>
                            </Grid>
                        </StackPanel>

                        <!-- Reboot needed -->
                        <StackPanel Visibility="{Binding IsRebootRequired, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Перезагрузить сейчас" Command="{Binding RebootNowCommand}" Style="{StaticResource BtnPrimary}"/>
                                <Button Content="Позже" Command="{Binding RebootLaterCommand}" Style="{StaticResource BtnSecondary}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextSmall}" Margin="0,12,0,0" Foreground="#B0B0B0"
                                       Text="После перезагрузки запустите установщик HQ Studio ещё раз: он продолжит с этого места."/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Docker missing: three simple steps -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                        <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource StepText}" Text="Нажмите «Установить Docker автоматически»: всё скачается само."/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource StepText}" Text="Когда Windows спросит разрешение, нажмите «Да»."/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource StepText}" Text="Подождите несколько минут: установщик сам увидит, что Docker готов."/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Buttons for the Docker-missing case -->
            <StackPanel Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                <Button Command="{Binding InstallAutoCommand}" Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch" Padding="20,13">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" Stroke="#0A0A0A" Width="18" Height="18"/>
                        <TextBlock Text="Установить Docker автоматически" Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Открыть страницу загрузки" Command="{Binding OpenDownloadPageCommand}"
                            Style="{StaticResource BtnLink}"/>
                    <Button Grid.Column="2" Content="Подробная инструкция" Command="{Binding OpenGuideCommand}"
                            Style="{StaticResource BtnLink}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                    <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" Stroke="#707070" Width="14" Height="14"
                          VerticalAlignment="Center" StrokeThickness="1.8"/>
                    <TextBlock Text="Если сайт docker.com не открывается, включите VPN." Style="{StaticResource TextSmall}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Docker running: what is next -->
            <StackPanel Orientation="Horizontal" Margin="2,14,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" Stroke="#707070" Width="14" Height="14"
                      VerticalAlignment="Center" StrokeThickness="1.8"/>
                <TextBlock Text="Дальше: имя и пароль главного аккаунта." Style="{StaticResource TextSmall}" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Messages -->
            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="{StaticResource DangerBgBrush}"
                    BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource TextBody}" Foreground="#FF8A80" FontSize="13" LineHeight="19"/>
            </Border>
            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="{StaticResource WarningBgBrush}"
                    BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasPostponedNote, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PostponedNote}" Style="{StaticResource TextBody}" Foreground="#FFE082" FontSize="13" LineHeight="19"/>
            </Border>

            <!-- Install later -->
            <CheckBox IsChecked="{Binding SkipDocker, Mode=TwoWay}" Style="{StaticResource SetupCheckBox}" Margin="2,16,0,0"
                      Visibility="{Binding ShowSkip, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Установлю Docker позже" FontSize="14" Foreground="#FFFFFF"/>
                    <TextBlock Text="Программа установится сейчас, а сайт можно будет поставить потом." Style="{StaticResource TextSmall}" Margin="0,1,0,0"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
