<UserControl x:Class="HQStudio.Setup.UI.Pages.WelcomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- soft glow behind the logo, like the app splash screen -->
        <Ellipse Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-90,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#14FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel VerticalAlignment="Center" Margin="0,-6,0,0">
            <TextBlock Text="HQ" FontSize="76" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" LineHeight="84" LineStackingStrategy="BlockLineHeight">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="STUDIO" FontSize="24" FontWeight="Light" Foreground="#B0B0B0" HorizontalAlignment="Center"
                       Margin="0,-6,0,0"/>

            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" HorizontalAlignment="Center" Margin="0,28,0,0"/>
            <TextBlock Style="{StaticResource TextBody}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="0,8,0,0"
                       Text="Мы установим всё необходимое за несколько минут. Понадобится ответить на несколько простых вопросов."/>

            <ItemsControl ItemsSource="{Binding Features}" Margin="0,28,0,0" IsTabStop="False" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,16,16,14" Margin="5,0">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left"
                                        Background="{StaticResource BgHoverBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1">
                                    <Path Data="{Binding IconKey, Converter={StaticResource Icon}}" Style="{StaticResource IconPath}"
                                          Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource TextSmall}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
