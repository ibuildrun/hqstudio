<UserControl x:Class="HQStudio.Setup.UI.Pages.KeysPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HQStudio.Setup.UI">
    <UserControl.Resources>
        <Style x:Key="OptionalChip" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
        </Style>
        <Style x:Key="KeyIconBox" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="WhereButton" TargetType="Button" BasedOn="{StaticResource BtnLink}">
            <Setter Property="Width" Value="156"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,4">

            <!-- Tuna token -->
            <Border Style="{StaticResource Card}" Padding="20,15,20,16">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource KeyIconBox}">
                                <Path Data="{StaticResource IconKey}" Style="{StaticResource IconPath}" Width="16" Height="16" StrokeThickness="1.8"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Токен Tuna" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="открывает сайт по вашему домену" Style="{StaticResource TextSmall}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource OptionalChip}">
                            <TextBlock Text="МОЖНО ПРОПУСТИТЬ" FontSize="10" FontWeight="SemiBold" Foreground="#B0B0B0"/>
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource TextBody}" FontSize="13" LineHeight="18" Margin="0,10,0,0"
                               Text="{Binding TokenHintText}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputText}" Text="{Binding TunaToken, UpdateSourceTrigger=PropertyChanged}"
                                 ui:Ui.HasError="{Binding HasTunaTokenError}" ui:Ui.Placeholder="Вставьте токен сюда"/>
                        <Button Grid.Column="2" Style="{StaticResource WhereButton}" Command="{Binding OpenTunaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Где взять токен" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource IconExternal}" Style="{StaticResource IconPath}" Width="13" Height="13"
                                      Stroke="#B0B0B0" StrokeThickness="2" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding TunaTokenError}" Style="{StaticResource TextError}" Margin="2,5,0,0"
                               Visibility="{Binding HasTunaTokenError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Own domain -->
            <Border Style="{StaticResource Card}" Padding="20,15,20,16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource KeyIconBox}">
                                <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconPath}" Width="16" Height="16" StrokeThickness="1.8"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Свой домен" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="адрес сайта для всех в интернете" Style="{StaticResource TextSmall}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource OptionalChip}">
                            <TextBlock Text="МОЖНО ПРОПУСТИТЬ" FontSize="10" FontWeight="SemiBold" Foreground="#B0B0B0"/>
                        </Border>
                    </Grid>
                    <TextBox Style="{StaticResource InputText}" Text="{Binding TunaDomain, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,0,0"
                             ui:Ui.HasError="{Binding HasTunaDomainError}" ui:Ui.Placeholder="Например, crm.example.ru"/>
                    <TextBlock Text="{Binding TunaDomainError}" Style="{StaticResource TextError}" Margin="2,5,0,0"
                               Visibility="{Binding HasTunaDomainError, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource BtnLink}" Command="{Binding OpenPunycodeCommand}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Padding="12,7"
                            Visibility="{Binding DomainNeedsPunycode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Преобразовать на reg.ru" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconExternal}" Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Stroke="#B0B0B0" StrokeThickness="2" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding DomainHintText}" Style="{StaticResource TextSmall}" LineHeight="17" Margin="2,9,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
