<UserControl x:Class="HQStudio.Setup.UI.Pages.InstallPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HQStudio.Setup.UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Overall progress -->
        <StackPanel Grid.Row="0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="{Binding CurrentAction}" FontSize="14" Foreground="#B0B0B0" VerticalAlignment="Bottom"
                           TextTrimming="CharacterEllipsis" Margin="0,0,70,1"/>
                <TextBlock Text="{Binding PercentText}" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
            <ProgressBar Style="{StaticResource SetupProgress}" Margin="0,10,0,0" Value="0" Maximum="100"
                         ui:Ui.SmoothValue="{Binding OverallPercent}"/>
        </StackPanel>

        <!-- Failure -->
        <Border Grid.Row="0" CornerRadius="14" Background="{StaticResource DangerBgBrush}" Margin="0,0,0,12"
                BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" Padding="16,12"
                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
            <Grid DataContext="{Binding Failure}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="#3A1A1A" BorderBrush="#F44336" BorderThickness="1"
                        VerticalAlignment="Top">
                    <Path Data="{StaticResource IconCross}" Style="{StaticResource IconPath}" Stroke="#F44336" Width="15" Height="15"
                          StrokeThickness="2.4"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Message}" FontSize="12.5" LineHeight="18" Foreground="#C8B4B4" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FFFFFF">
                        <Run Text="Что делать: " FontWeight="SemiBold"/><Run Text="{Binding Hint, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stages -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,6">
            <ScrollViewer x:Name="StageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StageList" ItemsSource="{Binding Stages}" IsTabStop="False" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="29" Margin="6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <Ellipse Stroke="#3A3A3A" StrokeThickness="1.5"
                                             Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"/>
                                    <Control Style="{StaticResource Spinner}" Width="22" Height="22"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                    <Grid Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Fill="#1A2A1A" Stroke="#4CAF50" StrokeThickness="1.5"/>
                                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Stroke="#4CAF50" Width="11" Height="11" StrokeThickness="2.4"/>
                                    </Grid>
                                    <Grid Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Fill="#3A1A1A" Stroke="#F44336" StrokeThickness="1.5"/>
                                        <Path Data="{StaticResource IconCross}" Style="{StaticResource IconPath}" Stroke="#F44336" Width="10" Height="10" StrokeThickness="2.4"/>
                                    </Grid>
                                    <Grid Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Fill="#2A2A1A" Stroke="#FFC107" StrokeThickness="1.5"/>
                                        <Path Data="M12,6 L12,13 M12,17.5 L12,17.7" Style="{StaticResource IconPath}" Stroke="#FFC107" Width="10" Height="10" StrokeThickness="3"/>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="0,5,0,4">
                                    <TextBlock x:Name="StageTitle" Text="{Binding Title}" FontSize="14" Foreground="#707070"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#707070" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="StageTitle" Property="Foreground" Value="#FFFFFF"/>
                                    <Setter TargetName="StageTitle" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="StageTitle" Property="Foreground" Value="#B0B0B0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="StageTitle" Property="Foreground" Value="#F44336"/>
                                    <Setter TargetName="StageTitle" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter TargetName="StageTitle" Property="Foreground" Value="#FFC107"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Technical details -->
        <Expander Grid.Row="2" x:Name="LogExpander" Style="{StaticResource SetupExpander}" Margin="0,6,0,0"
                  IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,4,0,0" Height="118" Background="{StaticResource BgSecondaryBrush}">
                <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#B0B0B0"
                         FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" SelectionBrush="#505050" IsTabStop="False"/>
            </Border>
        </Expander>
    </Grid>
</UserControl>
