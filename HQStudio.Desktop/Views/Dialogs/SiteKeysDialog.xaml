<Window x:Class="HQStudio.Views.Dialogs.SiteKeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ключи сайта"
        Width="600" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="KeysBtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Padding" Value="22,12"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeysBtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Padding" Value="20,12"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeysBtnSmall" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Поле ввода: недоступное бледнеет -->
        <Style x:Key="KeysInputText" TargetType="TextBox" BasedOn="{StaticResource InputText}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ссылка «Где взять» -->
        <Style x:Key="KeysLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка «Показать» у скрытого поля -->
        <Style x:Key="KeysShowToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" CornerRadius="10" BorderThickness="1" Padding="14,0" MinWidth="96"
                                Background="Transparent" BorderBrush="{DynamicResource BtnSecondaryBorderBrush}">
                            <TextBlock x:Name="Label" Text="Показать" FontSize="13" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Text" Value="Скрыть"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка «••••••• сохранён» -->
        <Style x:Key="KeysSavedRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,8,8,8"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimaryBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="16,16,0,0"
                    Padding="24,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Ключи сайта" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Токен Tuna и свой домен: по ним сайт открывается из интернета"
                                   Style="{DynamicResource TextSmall}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="✕" Click="CloseButton_Click" Style="{DynamicResource BtnIcon}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,8">

                    <!-- Tuna token -->
                    <TextBlock Text="ТОКЕН TUNA" Style="{DynamicResource TextLabel}" Margin="0,0,0,8"/>

                    <Border Style="{StaticResource KeysSavedRow}"
                            Visibility="{Binding ShowTunaSaved, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="•••••••  сохранён" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Изменить" Style="{StaticResource KeysBtnSmall}" Command="{Binding ChangeTunaCommand}"/>
                                <Button Content="Удалить" Style="{StaticResource KeysBtnSmall}" Command="{Binding ClearTunaCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource KeysSavedRow}"
                            Visibility="{Binding ShowTunaCleared, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="Токен будет удалён, адрес в интернете отключится" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#FFB300"/>
                            <Button Content="Вернуть" Style="{StaticResource KeysBtnSmall}" HorizontalAlignment="Right"
                                    Command="{Binding KeepTunaCommand}"/>
                        </Grid>
                    </Border>

                    <Grid Visibility="{Binding ShowTunaInput, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TunaPassword" Style="{DynamicResource InputPassword}"
                                     PasswordChanged="TunaPassword_PasswordChanged"
                                     Visibility="{Binding IsChecked, ElementName=TunaShow, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBox x:Name="TunaText" Style="{DynamicResource InputText}"
                                 Text="{Binding TunaInput, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsChecked, ElementName=TunaShow, Converter={StaticResource BoolToVisibility}}"/>
                        <ToggleButton x:Name="TunaShow" Grid.Column="1" Style="{StaticResource KeysShowToggle}"
                                      Checked="TunaShow_Changed" Unchecked="TunaShow_Changed"/>
                    </Grid>
                    <TextBlock Text="{Binding TunaInputError}" FontSize="12" Foreground="#F44336" Margin="2,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding TunaInputError, Converter={StaticResource StringToVisibility}}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Где взять токен" Style="{StaticResource KeysLink}" Command="{Binding OpenTunaHelpCommand}"/>
                        <Button Content="Оставить прежний" Style="{StaticResource KeysLink}" Margin="18,8,0,0"
                                Command="{Binding KeepTunaCommand}"
                                Visibility="{Binding CanCancelTunaEdit, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Own domain -->
                    <TextBlock Text="СВОЙ ДОМЕН" Style="{DynamicResource TextLabel}" Margin="0,24,0,8"/>
                    <TextBox Style="{StaticResource KeysInputText}"
                             Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" MaxLength="253"/>
                    <TextBlock Text="{Binding DomainError}" FontSize="12" Foreground="#F44336" Margin="2,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding DomainError, Converter={StaticResource StringToVisibility}}"/>
                    <Button Content="Перевести домен в латиницу (punycode)" Style="{StaticResource KeysLink}"
                            Command="{Binding OpenPunycodeCommand}"
                            Visibility="{Binding ShowPunycodeLink, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Style="{DynamicResource TextSmall}" TextWrapping="Wrap" Margin="2,8,0,0" LineHeight="18"
                               Text="Адрес вашего сайта, например crm.example.ru. Сначала добавьте его в личном кабинете Tuna (my.tuna.am/domains) и дождитесь подтверждения. Сайт откроется по этому адресу, когда указаны и токен, и домен. Если пока не готовы, оставьте поля пустыми: сайт будет работать на этом компьютере."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Личный кабинет Tuna (домены)" Style="{StaticResource KeysLink}"
                                Command="{Binding OpenTunaDomainsCommand}"/>
                        <Button Content="Как подключить свой домен" Style="{StaticResource KeysLink}" Margin="18,8,0,0"
                                Command="{Binding OpenGuideCommand}"
                                Visibility="{Binding CanOpenGuide, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Идёт применение -->
                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="12" Padding="18,14" Margin="0,22,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <Border Height="6" CornerRadius="3" Margin="0,10,0,0" ClipToBounds="True"
                                        Background="{DynamicResource BorderDefaultBrush}">
                                    <Border Width="140" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                            Background="{DynamicResource TextPrimaryBrush}">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-140"/>
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="BusyRun">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     From="-140" To="560" Duration="0:0:1.8"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="BusyRun"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource KeysBtnSmall}"
                                    Click="CancelApply_Click" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Результат -->
                    <Border CornerRadius="12" BorderThickness="1" Padding="16,14" Margin="0,18,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1F4CAF50"/>
                                <Setter Property="BorderBrush" Value="#664CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                        <Setter Property="Background" Value="#1FF44336"/>
                                        <Setter Property="BorderBrush" Value="#66F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="13" LineHeight="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ToggleButton x:Name="DetailsToggle" Margin="0,10,0,0" HorizontalAlignment="Left" Cursor="Hand"
                                          Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <TextBlock x:Name="Label" Text="Показать подробности" FontSize="12"
                                                   Foreground="#F44336" TextDecorations="Underline"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Label" Property="Text" Value="Скрыть подробности"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" MaxHeight="150"
                                     Style="{DynamicResource InputText}" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="24,16" Margin="0,8,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Закрыть" Style="{StaticResource KeysBtnSecondary}"
                            Click="CloseButton_Click" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Column="1" Content="Сохранить и применить" Style="{StaticResource KeysBtnPrimary}"
                            Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
