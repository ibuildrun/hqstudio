<Window x:Class="HQStudio.Views.Dialogs.SiteGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:HQStudio.Controls"
        Title="Инструкция"
        Width="900" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="GuideBtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuideBtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Выбор главы -->
        <Style x:Key="GuideChoiceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="16" BorderThickness="1" Padding="14,7"
                                Background="Transparent" BorderBrush="{DynamicResource BorderLightBrush}">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource BgPrimaryBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ссылка внутри шага -->
        <Style x:Key="GuideLinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="10" BorderThickness="1" Padding="14,7"
                                Background="Transparent" BorderBrush="{DynamicResource BtnSecondaryBorderBrush}">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimaryBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="16,16,0,0"
                    Padding="24,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Инструкция" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Пошаговая справка для администратора HQ Studio"
                                   Style="{DynamicResource TextSmall}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="✕" Click="CloseButton_Click" Style="{DynamicResource BtnIcon}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32"/>
                </Grid>
            </Border>

            <!-- Главы -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Choices}" Margin="24,18,24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Style="{StaticResource GuideChoiceButton}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Id}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Глава -->
            <ScrollViewer x:Name="ChapterScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel Margin="24,6,24,12">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Style="{DynamicResource TextBody}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="12" Padding="18,14" Margin="0,16,0,0"
                            Visibility="{Binding HasIntro, Converter={StaticResource BoolToVisibility}}">
                        <ctl:GuideTextBlock Markup="{Binding Intro}" Style="{DynamicResource TextBody}" LineHeight="21"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Padding="20,18" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"
                                                Background="{DynamicResource TextPrimaryBrush}">
                                            <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource BgPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>

                                            <ctl:GuideTextBlock Markup="{Binding Text}" Style="{DynamicResource TextBody}"
                                                                LineHeight="21" Margin="0,8,0,0"
                                                                Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- Таблица: что заполнить и что писать -->
                                            <ItemsControl ItemsSource="{Binding RowList}" Margin="0,10,0,0"
                                                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10"
                                                                Padding="14,10" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <ctl:GuideTextBlock Grid.Column="1" Markup="{Binding Value}"
                                                                                    Style="{DynamicResource TextBody}" FontSize="13"
                                                                                    LineHeight="19"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Что делать по пунктам -->
                                            <ItemsControl ItemsSource="{Binding BulletList}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasBullets, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="•" FontSize="14"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                            <ctl:GuideTextBlock Grid.Column="1" Markup="{Binding}"
                                                                                Style="{DynamicResource TextBody}" LineHeight="21"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Ссылки -->
                                            <ItemsControl ItemsSource="{Binding LinkList}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Text}" Style="{StaticResource GuideLinkButton}"
                                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Url}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Важно -->
                                            <Border Background="#1FFFB300" BorderBrush="#66FFB300" BorderThickness="1"
                                                    CornerRadius="10" Padding="14,10" Margin="0,8,0,0"
                                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                                <ctl:GuideTextBlock Markup="{Binding Note}" Style="{DynamicResource TextBody}"
                                                                    FontSize="13" LineHeight="19"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Сообщить об ошибке сейчас" Style="{StaticResource GuideBtnPrimary}"
                            Command="{Binding ReportBugCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Visibility="{Binding ShowReportBug, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="24,14,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ProgressText}" Style="{DynamicResource TextSmall}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Назад" Style="{StaticResource GuideBtnSecondary}" Command="{Binding PreviousCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Далее" Style="{StaticResource GuideBtnSecondary}" Command="{Binding NextCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Закрыть" Style="{StaticResource GuideBtnPrimary}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
