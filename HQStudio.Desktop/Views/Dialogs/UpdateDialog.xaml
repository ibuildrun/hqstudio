<Window x:Class="HQStudio.Views.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HQStudio.ViewModels"
        Title="Обновления HQ Studio"
        Width="660" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:UpdateViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="UpdateProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource BgInputBrush}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{DynamicResource TextPrimaryBrush}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateBtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UpdateBtnGhost" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimaryBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}"
                    CornerRadius="16,16,0,0" Padding="24,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Обновления" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Приложение и сайт обновляются отсюда одним нажатием"
                                   Style="{DynamicResource TextSmall}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="✕" Click="CloseButton_Click" Style="{DynamicResource BtnIcon}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,8">

                    <!-- Versions -->
                    <Border Style="{DynamicResource Card}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="110"/>
                                <ColumnDefinition Width="Auto" MinWidth="110"/>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="УСТАНОВЛЕНО" Style="{DynamicResource TextLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="ПОСЛЕДНЯЯ" Style="{DynamicResource TextLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="СОСТОЯНИЕ" Style="{DynamicResource TextLabel}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Приложение" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstalledAppVersion}"
                                       Style="{DynamicResource TextBody}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LatestVersion}"
                                       Style="{DynamicResource TextBody}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AppStateText}" Margin="0,12,0,0"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppUpdateAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Сайт" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstalledServerVersion}"
                                       Style="{DynamicResource TextBody}" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LatestVersion}"
                                       Style="{DynamicResource TextBody}" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ServerStateText}" Margin="0,10,0,0"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerUpdateAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Result / status line -->
                    <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource TextBody}" TextWrapping="Wrap"
                               Foreground="#4CAF50" Margin="2,14,2,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

                    <!-- Error -->
                    <Border Background="#2A1515" BorderBrush="#3A2020" BorderThickness="1" CornerRadius="12"
                            Padding="16" Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Не получилось" FontWeight="SemiBold" Foreground="#F44336" FontSize="13"/>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="#F44336" FontSize="13"/>
                            <Button Content="Открыть инструкцию" Style="{DynamicResource BtnSecondary}"
                                    Command="{Binding OpenHelpCommand}" Padding="14,8" FontSize="13"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Visibility="{Binding HasHelpUrl, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress -->
                    <Border Style="{DynamicResource Card}" Padding="20" Margin="0,14,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressStage}" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,0"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource UpdateProgressBar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding ProgressDetail}" Style="{DynamicResource TextSmall}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ProgressDetail, Converter={StaticResource StringToVisibility}}"/>
                            <TextBlock Text="Не закрывайте программу, пока идёт обновление." Style="{DynamicResource TextSmall}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Release notes -->
                    <Border Style="{DynamicResource Card}" Padding="20" Margin="0,14,0,0"
                            Visibility="{Binding HasReleaseInfo, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReleaseTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <TextBlock Text="{Binding ReleaseNotes}" Style="{DynamicResource TextBody}"
                                           TextWrapping="Wrap" FontSize="13"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Log -->
                    <Button Content="{Binding LogToggleText}" Command="{Binding ToggleLogCommand}"
                            Style="{DynamicResource BtnGhost}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Padding="8,6" FontSize="13"/>
                    <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             Style="{DynamicResource InputText}" FontFamily="Consolas" FontSize="12"
                             Height="170" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="10,8" Margin="0,4,0,0"
                             TextChanged="LogBox_TextChanged"
                             Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Обновить приложение" Style="{StaticResource UpdateBtnSecondary}"
                                Command="{Binding UpdateAppCommand}" Padding="12,12" FontSize="13" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Обновить сайт" Style="{StaticResource UpdateBtnSecondary}"
                                Command="{Binding UpdateServerCommand}" Padding="12,12" FontSize="13" Margin="6,0,6,0"/>
                        <Button Grid.Column="2" Content="Обновить всё" Style="{DynamicResource BtnPrimary}"
                                Command="{Binding UpdateAllCommand}" Padding="12,12" FontSize="13" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding SiteHint}" Style="{DynamicResource TextSmall}" TextWrapping="Wrap"
                               Margin="2,10,0,0"
                               Visibility="{Binding SiteHint, Converter={StaticResource StringToVisibility}}"/>
                    <Grid Margin="0,12,0,0">
                        <Button Content="Проверить обновления" Style="{StaticResource UpdateBtnGhost}"
                                Command="{Binding CheckCommand}" HorizontalAlignment="Left" Padding="8,8" FontSize="13"/>
                        <Button Content="Закрыть" Style="{DynamicResource BtnGhost}" Click="CloseButton_Click"
                                HorizontalAlignment="Right" Padding="12,8" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
